{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": false,
    "custom": {
      "rootLineHeight": "1.4",
      "rootPaddingRight": "var(--wp--preset--spacing--30)",
      "rootPaddingLeft": "var(--wp--preset--spacing--30)",
      "blockPaddingHorizontal": "var(--wp--preset--spacing--30)",
      "blockPaddingVertical": "var(--wp--preset--spacing--30)",
      "headingFontWeight": "normal",
      "headingLineHeight": "1",
      "headingMarginTop": "1.125em",
      "headingMarginBottom": "var(--wp--preset--spacing--20)"
    },
    "typography": {
      "defaultFontSizes": false,
      "fontSizes": [
        { "name": "Small", "size": "16px", "slug": "small" },
        { "name": "Medium", "size": "clamp(18px, 1.04vw, 20px)", "slug": "medium" },
        { "name": "Medium large", "size": "clamp(26px, 1.65vw, 32px)", "slug": "mediumlarge" },
        { "name": "Large", "size": "clamp(38px, 2.48vw, 48px)", "slug": "large" },
        { "name": "X large", "size": "clamp(48px, 3.2vw, 62px)", "slug": "xlarge" },
        { "name": "Huge", "size": "clamp(52px, 4.96vw, 96px)", "slug": "huge" }
      ],
      "fontFamilies": [
        {
          "name": "Body",
          "slug": "body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        },
        {
          "name": "Display",
          "slug": "display",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        }
      ]
    },
    "color": {
      "palette": [
        { "name": "Base", "slug": "base", "color": "#f5f5f5" },
        { "name": "Contrast", "slug": "contrast", "color": "#111111" },
        { "name": "Primary", "slug": "primary", "color": "#2f4f4f" },
        { "name": "Secondary", "slug": "secondary", "color": "#a3b8cc" },
        { "name": "Accent", "slug": "accent", "color": "#e2725b" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "name": "1", "size": "5px", "slug": "10" },
        { "name": "2", "size": "10px", "slug": "20" },
        { "name": "3", "size": "20px", "slug": "30" },
        { "name": "4", "size": "40px", "slug": "40" },
        { "name": "5", "size": "80px", "slug": "50" },
        { "name": "6", "size": "clamp(80px, 8.33vw, 160px)", "slug": "60" }
      ]
    },
    "layout": {}
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "var(--wp--custom--root-line-height)"
    },
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    }
  }
}

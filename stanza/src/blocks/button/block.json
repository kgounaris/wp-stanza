{
  "apiVersion": 3,
  "name": "stanza/button",
  "title": "Button",
  "category": "design",
  "description": "Prompt visitors to take action with a button-style link.",
  "attributes": {
    "url": {
      "type": "string",
      "source": "attribute",
      "selector": "a",
      "attribute": "href",
      "default": ""
    },
    "linkToForm": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "text": {
      "type": "string",
      "source": "html",
      "selector": "a",
      "default": ""
    }
  },
  "supports": {
    "anchor": true    
  },  
  "editorScript": [ "stanza-config", "file:./index.js" ]
}
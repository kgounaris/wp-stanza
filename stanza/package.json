{
  "name": "stanza",
  "version": "1.0.0",
  "private": true,
  "description": "Gutenberg blocks.",
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "start:editor": "wp-scripts start editor/src/index.js --output-path=editor/build",
    "build:editor": "wp-scripts build editor/src/index.js --output-path=editor/build",
    "start:all": "npm-run-all --parallel start start:editor"
  },
  "devDependencies": {
    "@wordpress/icons": "^10.32.0",
    "@wordpress/scripts": "^30.25.0",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "swiper": "^12.0.3"
  }
}
